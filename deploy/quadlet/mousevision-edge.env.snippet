# Drop-in / reference fragment for the existing mousevision.container
# Copy the Network= and Environment= lines into ~/.config/containers/systemd/mousevision.container
#
# Network=mousevision.network
# Environment=MOUSEVISION_VIDEO_BACKEND=ffmpeg
#
# --- Production: full-video agent (gemini-3-flash via CPA) ---
# Environment=MOUSEVISION_WEIGHT_READER=agent
# Environment=MOUSEVISION_AGENT_BASE_URL=http://agent.invalid:46450
# Environment=MOUSEVISION_AGENT_API_KEY=<cpa-downstream-key>
# Environment=MOUSEVISION_AGENT_MODEL=gemini-3-flash
# Environment=MOUSEVISION_RETAIN_SOURCE_VIDEO=1
#
# Optional classic seven-seg fallback (only if agent.fallback=http_ocr in yaml):
# Environment=MOUSEVISION_OCR_URL=http://mousevision-lcd-ocr:8768
#
# Legacy OCR-only mode (pre-agent):
# Environment=MOUSEVISION_WEIGHT_READER=http_ocr
# Environment=MOUSEVISION_OCR_URL=http://mousevision-lcd-ocr:8768
