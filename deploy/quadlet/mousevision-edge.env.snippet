# Drop-in / reference fragment for the existing mousevision.container
# Copy the Network= and Environment= lines into ~/.config/containers/systemd/mousevision.container
#
# Network=mousevision.network
# Environment=MOUSEVISION_OCR_URL=http://mousevision-lcd-ocr:8768
# Environment=MOUSEVISION_WEIGHT_READER=template
# After gate pass, change WEIGHT_READER to http_ocr.
