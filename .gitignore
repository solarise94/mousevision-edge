# ============================================================
# 鸿蒙 / Android 构建产物与本地工具链（不入库）
# ============================================================

# Command Line Tools（华为官方下载，~6GB，含 SDK/hdc/hvigor，不入库）
command-line-tools/

# Android SDK 根目录（本地下载的 cmdline-tools + platforms/build-tools/platform-tools）
android-sdk/

# 本地工具链暂存目录（含本地 Gradle 发行版 .toolchain/gradle-*/）
.toolchain/

# 鸿蒙 hvigor 构建产物与缓存
.hvigor/
**/hvigor/.hvigor/
harmonyos/**/build/
harmonyos/**/oh_modules/
harmonyos/**/*.tsbuildinfo
harmonyos/**/ts_checker_cache

# Android Gradle 构建产物
android/**/build/
android/.gradle/
android/local.properties
android/**/*.iml

# 鸿蒙签名私钥与 Profile（含密钥，不入库；.cer 证书链可入库）
harmonyos/MiceAutomaticScale/signature/*.p12
harmonyos/MiceAutomaticScale/signature/*.p7b
harmonyos/MiceAutomaticScale/signature/*.csr

# 硬件固件构建产物（arduino-cli 暂存 sketch 与编译输出；PIO 缓存）
hardware/**/.build/
hardware/**/.pio/
*.keystore
dist/

# 参考 app APK 与解包产物（仅本地逆向分析用，不入库）
refapp/

# E2E（G6）：Playwright 依赖与产物（package.json 仅测试依赖，不接管前端构建）
node_modules/
test-results/
playwright-report/
